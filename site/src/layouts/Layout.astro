---
const {
  title = "High Availability The Hard Way",
  description = "Runnable reliability engineering labs for AI-native systems."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #151719;
    --muted: #59616a;
    --paper: #f7f5ef;
    --panel: #ffffff;
    --line: #d7d1c4;
    --steel: #30495c;
    --blue: #2267a8;
    --green: #247657;
    --amber: #b86e1f;
    --red: #b7372f;
    --shadow: 0 18px 45px rgba(21, 23, 25, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: "Avenir Next", "Gill Sans", "Trebuchet MS", sans-serif;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    min-width: 320px;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  code {
    font-family: "SFMono-Regular", "Cascadia Mono", "Liberation Mono", monospace;
    font-size: 0.95em;
  }

  .shell {
    width: min(1160px, calc(100% - 32px));
    margin: 0 auto;
  }

  .topline {
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(90deg, rgba(48, 73, 92, 0.08) 1px, transparent 1px),
      linear-gradient(180deg, #fffdf8 0%, #f7f5ef 100%);
    background-size: 44px 44px, auto;
  }

  .overview {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 1.05fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    min-height: min(720px, 92vh);
    padding: 56px 0 48px;
  }

  .kicker {
    margin: 0 0 18px;
    color: var(--amber);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 680px;
    margin-bottom: 22px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 8vw, 7.5rem);
    line-height: 0.9;
    font-weight: 700;
  }

  .lede {
    max-width: 680px;
    margin-bottom: 28px;
    color: #31373d;
    font-size: clamp(1.08rem, 2vw, 1.32rem);
    line-height: 1.55;
  }

  .loop {
    display: inline-flex;
    max-width: 100%;
    border: 1px solid var(--ink);
    border-radius: 6px;
    background: var(--panel);
    padding: 12px 14px;
    box-shadow: 7px 7px 0 var(--ink);
    font-family: "SFMono-Regular", "Cascadia Mono", "Liberation Mono", monospace;
    font-size: clamp(0.78rem, 1.4vw, 0.96rem);
    line-height: 1.45;
    white-space: normal;
  }

  .map-panel {
    margin: 0;
  }

  .map-panel img {
    width: 100%;
    border: 1px solid var(--ink);
    border-radius: 8px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .map-panel figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .band {
    border-bottom: 1px solid var(--line);
    padding: 56px 0;
  }

  .band.white {
    background: #fffdf8;
  }

  .band.dark {
    background: #151719;
    color: #f7f5ef;
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(260px, 0.3fr);
    gap: 28px;
    align-items: end;
    margin-bottom: 28px;
  }

  .section-head h2 {
    margin-bottom: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 3.7rem);
    line-height: 1;
  }

  .section-head p {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .band.dark .section-head p {
    color: #c8d0d6;
  }

  .pillar-grid,
  .lab-grid,
  .command-grid {
    display: grid;
    gap: 16px;
  }

  .pillar-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .lab-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .command-grid {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    padding: 20px;
  }

  .band.dark .card {
    border-color: rgba(247, 245, 239, 0.22);
    background: rgba(255, 255, 255, 0.06);
  }

  .card h3 {
    margin-bottom: 10px;
    font-size: 1.02rem;
  }

  .card p {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .band.dark .card p {
    color: #c8d0d6;
  }

  .lab-card {
    min-height: 260px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .lab-number {
    display: inline-grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 700;
  }

  .lab-card strong {
    display: block;
    color: var(--ink);
    font-size: 1.25rem;
  }

  .lab-card code {
    margin-top: auto;
    color: var(--steel);
  }

  .status-line {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .status-line li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 10px;
    background: #fff;
    color: #2d3339;
    font-size: 0.88rem;
  }

  .terminal {
    margin: 0;
    border: 1px solid #38424b;
    border-radius: 8px;
    background: #0f1215;
    color: #e7ecef;
    padding: 20px;
    overflow-x: auto;
    line-height: 1.7;
  }

  .accent-blue {
    border-top: 4px solid var(--blue);
  }

  .accent-green {
    border-top: 4px solid var(--green);
  }

  .accent-red {
    border-top: 4px solid var(--red);
  }

  @media (max-width: 900px) {
    .overview,
    .section-head,
    .command-grid,
    .pillar-grid,
    .lab-grid {
      grid-template-columns: 1fr;
    }

    .overview {
      min-height: auto;
      padding-top: 42px;
    }
  }

  @media (max-width: 560px) {
    .shell {
      width: min(100% - 22px, 1160px);
    }

    .band {
      padding: 38px 0;
    }

    .loop,
    .terminal {
      width: 100%;
    }

    .card {
      padding: 16px;
    }
  }
</style>
