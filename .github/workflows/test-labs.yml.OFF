name: Test labs

on:
  push:
    branches:
      - main
  pull_request:

jobs:
  static-contracts:
    name: Static lab contracts
    runs-on: ubuntu-latest

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Set up uv
        uses: astral-sh/setup-uv@v5

      - name: Install Python dependencies
        run: |
          uv pip install --system -r docuask/api/requirements.txt -r docuask/worker/requirements.txt pyyaml

      - name: Run unit and static contract tests
        run: |
          python3 -m pytest docuask/tests tests labs/01-baseline-app/tests labs/02-timeouts/tests labs/03-retries-jitter/tests labs/04-idempotency/tests -q

      - name: Check shell script syntax
        run: |
          bash -n shared/scripts/*.sh labs/01-baseline-app/scripts/*.sh labs/02-timeouts/scripts/*.sh labs/03-retries-jitter/scripts/*.sh labs/04-idempotency/scripts/*.sh

      - name: Validate Docker Compose configs
        run: |
          docker compose -f shared/docker-compose.yml config --quiet
          docker compose -f labs/01-baseline-app/docker-compose.yml config --quiet
          docker compose -f labs/02-timeouts/docker-compose.yml config --quiet
          docker compose -f labs/03-retries-jitter/docker-compose.yml config --quiet
          docker compose -f labs/04-idempotency/docker-compose.yml config --quiet

      - name: Check whitespace
        run: |
          git diff --check
